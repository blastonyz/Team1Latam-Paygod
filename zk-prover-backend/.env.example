# Server
PORT=8080
ALLOWED_ORIGIN=*

# Mode: when true, ignores recipient/amount from request and always uses fixed values.
DEMO_FIXED_MODE=true
DEMO_RECIPIENT_ADDRESS=0x90813c2C61EE01857c2fDfD003f5272b540a7AA7
DEMO_TRANSFER_AMOUNT_BASE_UNITS=2500
DEMO_MINT_AMOUNT_BASE_UNITS=10000

# Path to EncryptedERC project from zk-prover-backend directory.
ENCRYPTED_ERC_ROOT=../EncryptedERC

# Required by EncryptedERC hardhat scripts (test keys accepted for this demo)
AVA_PK=
AVA_PK2=
AVA_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
