# Server
PORT=8080
ALLOWED_ORIGIN=https://team1-latam-paygod.vercel.app/;http://localhost:3000
PAYGOD_RUNTIME_MODE=production

# Security (production defaults are secure even if omitted)
REQUIRE_API_AUTH=true
BACKEND_API_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Endpoint exposure (only register should be public by default)
ENABLE_REGISTER_ENDPOINT=true

# Path to EncryptedERC project from zk-prover-backend directory.
ENCRYPTED_ERC_ROOT=../EncryptedERC

# Optional: override Fuji RPC for proof generation/register checks.
AVA_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
