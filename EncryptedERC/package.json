{
	"name": "encryptederc",
	"version": "1.0.0",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
		"@nomicfoundation/hardhat-ethers": "^3.0.8",
		"@openzeppelin/contracts": "^5.1.0",
		"@solarity/chai-zkit": "^0.3.1",
		"@solarity/hardhat-zkit": "^0.5.15",
		"@typechain/hardhat": "^9.1.0",
		"@types/jest": "^29.5.14",
		"@types/mocha": "^10.0.10",
		"@zk-kit/baby-jubjub": "^1.0.3",
		"dotenv": "^16.4.7",
		"hardhat": "^2.22.15",
		"hardhat-gas-reporter": "^2.2.3",
		"maci-crypto": "^2.0.0",
		"patch-package": "^8.0.1",
		"poseidon-lite": "^0.3.0",
		"prettier": "^3.5.3",
		"prettier-plugin-solidity": "^1.4.2",
		"solhint": "^5.0.5",
		"solidity-coverage": "^0.8.14"
	},
	"scripts": {
		"test": "mocha 'src/**/*.test.js'",
		"deploy:generic": "npx hardhat run scripts/deploy-generic-transfer-burn.ts",
		"deploy:testnet": "npx hardhat run scripts/deploy-generic-transfer-burn.ts --network fuji",
		"deploy:generic:fuji": "npx hardhat run scripts/deploy-generic-transfer-burn.ts --network fuji",
		"deploy:generic:avax": "npx hardhat run scripts/deploy-generic-transfer-burn.ts --network avalanche",
		"transfer:generic:fuji": "npx hardhat run scripts/transfer-generic.ts --network fuji",
		"deploy:encrypted:fuji": "npx hardhat run scripts/deploy-encrypted-erc.ts --network fuji",
		"register:users:fuji": "npx hardhat run scripts/register-users.ts --network fuji",
		"register:recipient:fuji": "npx hardhat run scripts/register-recipient.ts --network fuji",
		"reregister:known:fuji": "npx hardhat run scripts/reregister-known-users.ts --network fuji",
		"set:auditor:fuji": "npx hardhat run scripts/set-auditor.ts --network fuji",
		"set:auditor:pk3:fuji": "AUDITOR_ADDRESS=0x21fC720BED21720fF16b17023c370A62441cDBa2 npx hardhat run scripts/set-auditor.ts --network fuji",
		"transfer:private:fuji": "npx hardhat run scripts/private-transfer-fuji.ts --network fuji",
		"decrypt:private:tx:fuji": "npx hardhat run scripts/decrypt-private-tx.ts --network fuji",
		"index:balances:fuji": "npx hardhat run scripts/index-encrypted-balances.ts --network fuji",
		"smoke:generic": "npx hardhat run scripts/smoke-generic-transfer-burn.ts",
		"zkit:make": "hardhat zkit make --force && node scripts/fix-zkit-imports.cjs",
		"zkit:fix-imports": "node scripts/fix-zkit-imports.cjs",
		"zkit:verifiers": "node scripts/run-zkit-verifiers.cjs",
		"postinstall": "patch-package && npx hardhat compile & npm run zkit:make && npm run zkit:verifiers",
		"lint:sol": "solhint '**/*.sol' --config ./.solhint.json --ignore-path ./.solhintignore --max-warnings 0 && npx prettier --check '**/*.sol' --config ./.prettierrc",
		"lint:ts": "npx biome lint .",
		"lint": "npm run lint:sol && npm run lint:ts"
	},
	"keywords": [],
	"author": "",
	"repository": {
		"url": "https://github.com/ava-labs/EncryptedERC",
		"type": "git"
	}
}
